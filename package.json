{
  "name": "rei-booking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --env test --var APP_ORIGIN:http://localhost:8787",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "db:local": "wrangler d1 migrations apply rei-booking-test --env test --local",
    "owner:prepare": "node scripts/prepare-owner.mjs",
    "deploy:test": "node scripts/check-config.mjs && wrangler deploy --env test",
    "build": "wrangler deploy --env test --dry-run --outdir dist",
    "format": "prettier --write src public scripts tests docs README.md package.json wrangler.json .github/workflows/ci.yml"
  },
  "devDependencies": {
    "miniflare": "5.20260921.0-alpha",
    "prettier": "3.9.8",
    "wrangler": "4.136.3"
  }
}
