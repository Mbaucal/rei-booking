{
  "name": "rei-booking",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --env test --var APP_ORIGIN:http://localhost:8787",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "db:local": "wrangler d1 migrations apply rei-booking-test --env test --local",
    "owner:prepare": "node scripts/prepare-owner.mjs",
    "owner:form": "node scripts/build-owner-console.mjs",
    "owner:reset": "node scripts/setup-test.mjs --reset-password",
    "setup:test": "node scripts/setup-test.mjs",
    "deploy:test": "node scripts/check-config.mjs && wrangler deploy --env test",
    "build": "node scripts/check-config.mjs && wrangler deploy --env test --dry-run --outdir dist",
    "format": "prettier --write src public scripts tests docs README.md package.json wrangler.json .github/workflows/ci.yml",
    "photos:codec": "node scripts/build-photo-codec.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "esbuild": "0.28.1",
    "jpeg-js": "0.4.4",
    "miniflare": "5.20260921.0-alpha",
    "prettier": "3.9.8",
    "wrangler": "4.136.3"
  }
}
