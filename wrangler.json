{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rei-booking",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "test": {
      "name": "rei-booking-test",
      "vars": {
        "APP_ENV": "test",
        "APP_ORIGIN": "https://rei-booking-test.mbaucal.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rei-booking-test",
          "database_id": "7078aa06-6963-4e34-bdee-90e32e2764ae",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
